@page "/app/acuity-import"
@using DotNetWebApp.Services.Models
@inject HttpClient Http
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Acuity Import - GWMS</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">
                        Acuity Import System
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" Style="color: #6c757d;">
                        Upload Acuity scheduling CSV files to import appointment data into the warehouse scheduler.
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow>
        <RadzenColumn Size="12" MD="8">
            <RadzenCard>
                <RadzenStack Gap="1.5rem">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">
                        Upload CSV File
                    </RadzenText>

                    <RadzenStack Gap="1rem">
                        <RadzenFormField Text="User Name" Variant="@Variant.Outlined">
                            <RadzenTextBox @bind-Value="@userName" Style="width: 100%; max-width: 300px;" />
                        </RadzenFormField>

                        <RadzenFormField Text="CSV File" Variant="@Variant.Outlined">
                            <InputFile OnChange="@OnFileSelected" accept=".csv" class="form-control" />
                        </RadzenFormField>

                        @if (selectedFile != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="@Variant.Flat" Shade="Shade.Lighter">
                                <RadzenText TextStyle="TextStyle.Body2">
                                    <strong>Selected:</strong> @selectedFile.Name (@FormatFileSize(selectedFile.Size) bytes)
                                </RadzenText>
                            </RadzenAlert>
                        }

                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenButton
                                Text="@(isProcessing ? "Processing..." : "Upload and Process")"
                                ButtonStyle="@ButtonStyle.Primary"
                                Click="@ProcessFile"
                                Disabled="@(selectedFile == null || isProcessing)"
                                Icon="upload"
                                Size="@ButtonSize.Large" />

                            @if (isProcessing)
                            {
                                <RadzenProgressBarCircular ShowValue="false" Mode="@ProgressBarMode.Indeterminate" Size="@ProgressBarCircularSize.Small" />
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" MD="4">
            <RadzenCard Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="color: white;">
                        Quick Guide
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: rgba(255,255,255,0.9);">
                        <ol style="margin: 0; padding-left: 1.2rem;">
                            <li>Enter your username</li>
                            <li>Select Acuity CSV file (schedule*.csv)</li>
                            <li>Click "Upload and Process"</li>
                            <li>Review import results</li>
                        </ol>
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    @if (importResult != null)
    {
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenCard Style="@(importResult.HasErrors ? "border-left: 4px solid #dc3545;" : "border-left: 4px solid #28a745;")">
                    <RadzenStack Gap="1.5rem">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle="TextStyle.H6">
                                Import Results
                            </RadzenText>
                            <RadzenBadge
                                Text="@(importResult.HasErrors ? "With Errors" : "Success")"
                                BadgeStyle="@(importResult.HasErrors ? BadgeStyle.Danger : BadgeStyle.Success)"
                                IsPill="true" />
                        </RadzenStack>

                        <RadzenRow>
                            <RadzenColumn Size="6" MD="3">
                                <RadzenCard Variant="@Variant.Outlined">
                                    <RadzenStack Gap="0.5rem" class="text-center">
                                        <RadzenText TextStyle="TextStyle.Overline" Style="color: #6c757d;">Total Rows</RadzenText>
                                        <RadzenText TextStyle="TextStyle.H4">@importResult.TotalRows</RadzenText>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                            <RadzenColumn Size="6" MD="3">
                                <RadzenCard Variant="@Variant.Outlined">
                                    <RadzenStack Gap="0.5rem" class="text-center">
                                        <RadzenText TextStyle="TextStyle.Overline" Style="color: #28a745;">Inserts</RadzenText>
                                        <RadzenText TextStyle="TextStyle.H4" Style="color: #28a745;">@importResult.SuccessfulInserts</RadzenText>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                            <RadzenColumn Size="6" MD="3">
                                <RadzenCard Variant="@Variant.Outlined">
                                    <RadzenStack Gap="0.5rem" class="text-center">
                                        <RadzenText TextStyle="TextStyle.Overline" Style="color: #17a2b8;">Updates</RadzenText>
                                        <RadzenText TextStyle="TextStyle.H4" Style="color: #17a2b8;">@importResult.SuccessfulUpdates</RadzenText>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                            <RadzenColumn Size="6" MD="3">
                                <RadzenCard Variant="@Variant.Outlined">
                                    <RadzenStack Gap="0.5rem" class="text-center">
                                        <RadzenText TextStyle="TextStyle.Overline" Style="color: #dc3545;">Errors</RadzenText>
                                        <RadzenText TextStyle="TextStyle.H4" Style="color: #dc3545;">@importResult.Errors</RadzenText>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenText TextStyle="TextStyle.Body2" Style="color: #6c757d;">
                            Processed at: @importResult.ProcessedAt.ToString("yyyy-MM-dd HH:mm:ss")
                        </RadzenText>

                        @if (importResult.ErrorDetails.Any())
                        {
                            <RadzenStack Gap="1rem">
                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: #dc3545;">
                                    Error Details (@importResult.ErrorDetails.Count)
                                </RadzenText>

                                <RadzenDataGrid Data="@importResult.ErrorDetails" TItem="ImportError"
                                                AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="10"
                                                Style="max-height: 400px;">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="ImportError" Property="OrderNumber" Title="Order Number" Width="140px" />
                                        <RadzenDataGridColumn TItem="ImportError" Property="ErrorMessage" Title="Error Message" Width="300px" />
                                        <RadzenDataGridColumn TItem="ImportError" Property="CompanyName" Title="Company" Width="180px" />
                                        <RadzenDataGridColumn TItem="ImportError" Property="AppointmentId" Title="Appointment ID" Width="120px" />
                                        <RadzenDataGridColumn TItem="ImportError" Property="ScheduleDate" Title="Schedule Date" Width="140px">
                                            <Template Context="error">
                                                @(error.ScheduleDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>

@code {
    private IBrowserFile? selectedFile;
    private string userName = "testuser";
    private bool isProcessing = false;
    private AcuityImportResult? importResult;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importResult = null; // Clear previous results
    }

    private async Task ProcessFile()
    {
        if (selectedFile == null)
            return;

        try
        {
            isProcessing = true;

            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)); // 10MB limit
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("text/csv");
            content.Add(fileContent, "file", selectedFile.Name);
            content.Add(new StringContent(userName), "userName");

            var response = await Http.PostAsync("/api/AcuityImport/upload", content);

            if (response.IsSuccessStatusCode)
            {
                importResult = await response.Content.ReadFromJsonAsync<AcuityImportResult>();

                if (importResult?.HasErrors == true)
                {
                    NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Warning,
                            Summary = "Import Completed with Errors",
                            Detail = $"{importResult.TotalSuccess} records processed, {importResult.Errors} errors",
                            Duration = 5000
                        });
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage
                        {
                            Severity = NotificationSeverity.Success,
                            Summary = "Import Successful",
                            Detail = $"{importResult?.TotalSuccess ?? 0} records processed successfully",
                            Duration = 4000
                        });
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Import Failed",
                        Detail = $"HTTP {response.StatusCode}: {errorContent}",
                        Duration = 0
                    });
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to process file: {ex.Message}",
                    Duration = 0
                });
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes}";
        if (bytes < 1024 * 1024) return $"{bytes / 1024:F1} KB";
        return $"{bytes / (1024 * 1024):F1} MB";
    }
}
