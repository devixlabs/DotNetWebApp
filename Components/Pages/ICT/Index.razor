@page "/ict-orders"
@using DotNetWebApp.Services.ICT
@using DotNetWebApp.Services.ICT.Models
@inject IICTService ICTService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>ICT Orders</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenText TextStyle="TextStyle.H4">ICT (Inter-Company Transfer) Orders</RadzenText>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenLabel Text="Warehouse:" />
            <RadzenDropDown @bind-Value="@selectedWarehouseId"
                            Data="@warehouses"
                            TextProperty="Name"
                            ValueProperty="Id"
                            Change="@OnWarehouseChanged" />
            <RadzenButton Text="Create New Order" Icon="add" Click="@OnCreateNewOrder" ButtonStyle="@ButtonStyle.Primary" />
            <RadzenButton Text="Refresh" Icon="refresh" Click="@LoadOrders" />
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="@ProgressBarMode.Indeterminate" />
        <RadzenText>Loading orders...</RadzenText>
    }
    else if (orders != null && orders.Any())
    {
        <RadzenDataGrid Data="@orders"
                        TItem="ICTOrderSummary"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowPaging="true"
                        PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="ICTOrderSummary" Property="OrderNumber" Title="Order #" Width="150px">
                    <Template Context="order">
                        <RadzenLink Path="@($"/ict-orders/{order.OrderNumber}")" Text="@order.OrderNumber" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ICTOrderSummary" Property="CreatedDate" Title="Created" FormatString="{0:M/d/yyyy}" Width="120px" />
                <RadzenDataGridColumn TItem="ICTOrderSummary" Property="LineCount" Title="Products" Width="100px" />
                <RadzenDataGridColumn TItem="ICTOrderSummary" Property="TotalPallets" Title="Pallets" Width="100px" />
                <RadzenDataGridColumn TItem="ICTOrderSummary" Property="TotalNetWeight" Title="Net Weight" Width="120px" FormatString="{0:N2}" />
                <RadzenDataGridColumn TItem="ICTOrderSummary" Property="TotalGrossWeight" Title="Gross Weight" Width="120px" FormatString="{0:N2}" />
                <RadzenDataGridColumn TItem="ICTOrderSummary" Title="Actions" Width="200px" Sortable="false" Filterable="false">
                    <Template Context="order">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="View" Size="@ButtonSize.Small" Click="@(() => ViewOrder(order.OrderNumber))" />
                            <RadzenButton Text="Delete" Size="@ButtonSize.Small" ButtonStyle="@ButtonStyle.Danger"
                                          Click="@(() => DeleteOrder(order.OrderNumber))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
    else if (!isLoading)
    {
        <RadzenAlert AlertStyle="@AlertStyle.Info" AllowClose="false">
            No ICT orders found for @GetWarehouseName(selectedWarehouseId). Click "Create New Order" to start.
        </RadzenAlert>
    }
</RadzenStack>

@code {
    private List<ICTOrderSummary> orders = new();
    private int selectedWarehouseId = 3; // Default to CPFG
    private bool isLoading = false;

    private List<WarehouseOption> warehouses = new()
    {
        new WarehouseOption { Id = 3, Name = "CPFG (Niles)" },
        new WarehouseOption { Id = 92, Name = "Northlake" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            var result = await ICTService.ListOrdersAsync(selectedWarehouseId);
            orders = result.ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Loading Orders",
                Detail = ex.Message,
                Duration = 5000
            });
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnWarehouseChanged()
    {
        await LoadOrders();
    }

    private async Task OnCreateNewOrder()
    {
        try
        {
            var request = new CreateICTOrderRequest
            {
                SourceWarehouseId = selectedWarehouseId == 3 ? 92 : 3, // Opposite warehouse
                DestinationWarehouseId = selectedWarehouseId,
                Notes = "New ICT Order"
            };

            var order = await ICTService.CreateOrderAsync(request);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Order Created",
                Detail = $"ICT Order {order.OrderNumber} created successfully",
                Duration = 3000
            });

            Navigation.NavigateTo($"/ict-orders/{order.OrderNumber}");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error Creating Order",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private void ViewOrder(string orderNumber)
    {
        Navigation.NavigateTo($"/ict-orders/{orderNumber}");
    }

    private async Task DeleteOrder(string orderNumber)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete order {orderNumber}?",
            "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var result = await ICTService.DeleteOrderAsync(orderNumber, selectedWarehouseId);

                if (result.Success)
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Order Deleted",
                        Detail = $"Order {orderNumber} deleted successfully",
                        Duration = 3000
                    });

                    await LoadOrders();
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Delete Failed",
                        Detail = result.ErrorMessage,
                        Duration = 5000
                    });
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error Deleting Order",
                    Detail = ex.Message,
                    Duration = 5000
                });
            }
        }
    }

    private string GetWarehouseName(int warehouseId)
    {
        return warehouses.FirstOrDefault(w => w.Id == warehouseId)?.Name ?? "Unknown";
    }

    private class WarehouseOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    [Inject] private DialogService DialogService { get; set; } = default!;
}
