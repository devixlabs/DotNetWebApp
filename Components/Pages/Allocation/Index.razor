@page "/app/allocation"
@using DotNetWebApp.Services.Allocation
@using DotNetWebApp.Services.Allocation.Models
@inject IAllocationService AllocationService
@inject ILockService LockService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>Allocation</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-p-4">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.H4">Inventory Allocation</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenDropDown @bind-Value="selectedWarehouseId"
                           Data="@warehouses"
                           TextProperty="Name"
                           ValueProperty="Id"
                           Style="width: 150px;"
                           Change="@OnWarehouseChanged" />
            <RadzenDatePicker @bind-Value="selectedDate"
                             DateFormat="MM/dd/yyyy"
                             Style="width: 150px;"
                             Change="@OnDateChanged" />
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="@ButtonStyle.Light"
                         Click="@LoadOrders" />
        </RadzenStack>
    </RadzenStack>

    @if (isLoading)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 200px;">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
            <RadzenText TextStyle="TextStyle.Body1">Loading orders...</RadzenText>
        </RadzenStack>
    }
    else if (orders != null && orders.Any())
    {
        <RadzenCard>
            <RadzenDataGrid @ref="ordersGrid"
                           Data="@orders"
                           TItem="AllocationOrderSummary"
                           AllowFiltering="true"
                           AllowSorting="true"
                           AllowPaging="true"
                           PageSize="15"
                           SelectionMode="DataGridSelectionMode.Single"
                           @bind-Value="selectedOrders"
                           RowRender="@OnRowRender"
                           RowDoubleClick="@OnRowDoubleClick">
                <Columns>
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="OrderNumber" Title="Order #" Width="120px" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="DueShipDate" Title="Ship Date" Width="100px" FormatString="{0:MM/dd}" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="CustomerName" Title="Customer" Width="200px" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="Carrier" Title="Carrier" Width="150px" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="TotalLines" Title="Lines" Width="80px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="TotalOrdered" Title="Ordered" Width="100px" FormatString="{0:N0}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="TotalAllocated" Title="Allocated" Width="100px" FormatString="{0:N0}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Title="Status" Width="130px">
                        <Template Context="order">
                            <RadzenBadge Text="@AllocationStatusColorService.GetStatusText(order.Status)"
                                        BadgeStyle="@GetBadgeStyle(order.Status)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="OkToShip" Title="OK Ship" Width="80px" TextAlign="TextAlign.Center">
                        <Template Context="order">
                            @if (order.OkToShip)
                            {
                                <RadzenIcon Icon="check_circle" Style="color: green;" />
                            }
                            else
                            {
                                <RadzenIcon Icon="cancel" Style="color: red;" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Property="LockedBy" Title="Locked By" Width="100px" />
                    <RadzenDataGridColumn TItem="AllocationOrderSummary" Title="Actions" Width="150px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="order">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <RadzenButton Icon="visibility" ButtonStyle="@ButtonStyle.Info" Size="ButtonSize.Small"
                                             Click="@(() => ViewOrder(order.OrderNumber))" title="View Details" />
                                <RadzenButton Icon="play_arrow" ButtonStyle="@ButtonStyle.Success" Size="ButtonSize.Small"
                                             Click="@(() => AllocateOrder(order))" title="Allocate"
                                             Disabled="@(order.Status == AllocationStatus.FullyAllocated || !string.IsNullOrEmpty(order.LockedBy))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.Body2">
                Total: @orders.Count() orders |
                Not Allocated: @orders.Count(o => o.Status == AllocationStatus.NotAllocated) |
                Partial: @orders.Count(o => o.Status == AllocationStatus.PartiallyAllocated) |
                Full: @orders.Count(o => o.Status == AllocationStatus.FullyAllocated)
            </RadzenText>
        </RadzenStack>
    }
    else
    {
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="padding: 2rem;">
                <RadzenIcon Icon="inventory_2" Style="font-size: 48px; color: gray;" />
                <RadzenText TextStyle="TextStyle.H6">No orders found for allocation</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">Try selecting a different date or warehouse</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private RadzenDataGrid<AllocationOrderSummary>? ordersGrid;
    private IEnumerable<AllocationOrderSummary>? orders;
    private IList<AllocationOrderSummary>? selectedOrders;
    private bool isLoading = true;
    private int selectedWarehouseId = 3;
    private DateTime selectedDate = DateTime.Today;
    private string currentUsername = "testuser"; // TODO: Get from authentication

    private readonly List<WarehouseOption> warehouses = new()
    {
        new WarehouseOption { Id = 3, Name = "CPFG" },
        new WarehouseOption { Id = 92, Name = "Northlake" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            orders = await AllocationService.GetOrdersForAllocationAsync(selectedWarehouseId, selectedDate);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to load orders: {ex.Message}",
                Duration = 5000
            });
            orders = Enumerable.Empty<AllocationOrderSummary>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnWarehouseChanged(object value)
    {
        await LoadOrders();
    }

    private async Task OnDateChanged(DateTime? value)
    {
        if (value.HasValue)
        {
            selectedDate = value.Value;
            await LoadOrders();
        }
    }

    private void OnRowRender(RowRenderEventArgs<AllocationOrderSummary> args)
    {
        // Apply color coding based on allocation status
        args.Attributes.Add("style", AllocationStatusColorService.GetRowStyle(args.Data.Status));
    }

    private void OnRowDoubleClick(DataGridRowMouseEventArgs<AllocationOrderSummary> args)
    {
        ViewOrder(args.Data.OrderNumber);
    }

    private void ViewOrder(string orderNumber)
    {
        NavigationManager.NavigateTo($"/app/allocation/{orderNumber}?warehouseId={selectedWarehouseId}");
    }

    private async Task AllocateOrder(AllocationOrderSummary order)
    {
        try
        {
            var result = await AllocationService.AllocateOrderAsync(
                order.OrderNumber, currentUsername, selectedWarehouseId);

            if (result.Success)
            {
                var message = result.QuantityShort > 0
                    ? $"Partially allocated: {result.QuantityAllocated:N0} units, {result.QuantityShort:N0} short"
                    : $"Fully allocated: {result.QuantityAllocated:N0} units";

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = result.QuantityShort > 0 ? NotificationSeverity.Warning : NotificationSeverity.Success,
                    Summary = "Allocation Complete",
                    Detail = message,
                    Duration = 4000
                });

                await LoadOrders();
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Allocation Failed",
                    Detail = result.ErrorMessage,
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to allocate order: {ex.Message}",
                Duration = 5000
            });
        }
    }

    private static BadgeStyle GetBadgeStyle(AllocationStatus status)
    {
        return status switch
        {
            AllocationStatus.NotAllocated => BadgeStyle.Light,
            AllocationStatus.PartiallyAllocated => BadgeStyle.Warning,
            AllocationStatus.FullyAllocated => BadgeStyle.Success,
            AllocationStatus.OverAllocated => BadgeStyle.Danger,
            _ => BadgeStyle.Light
        };
    }

    private class WarehouseOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
